# Render Web Service: Root Directory=clinic-backend, Build=npm install, Start=npm start
NODE_ENV=production
PORT=4000
# Use exact scheme+host(s) of Cafe24 frontend; no path, no trailing slash.
FRONTEND_ORIGIN=https://heartbreakkid.co.kr,http://heartbreakkid.co.kr
ADMIN_FRONTEND_ORIGINS=https://heartbreakkid.co.kr,http://heartbreakkid.co.kr
# Generate both independently: at least 32 random bytes. NEVER commit real values.
JWT_SECRET=
ADMIN_JWT_SECRET=
# Render Free filesystem is ephemeral; this is FOR DEMO only.
SQLITE_PATH=./data/clinic.sqlite
SQLITE_AUTO_SCHEMA=false
SQLITE_QUERY_LOGGING=false
ENABLE_BACKGROUND_WORKERS=false
RESERVATION_MESSAGE_TRANSPORT=disabled
# Social OAuth needs separate provider keys and an HTTPS callback origin.
SOCIAL_AUTH_ENABLED=false
